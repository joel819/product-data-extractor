# Copy to .env and edit. Every variable is optional; defaults are shown.

# --- Fetching ---
USER_AGENT=product-data-extractor/0.1 (+https://github.com/joel819/product-data-extractor)
REQUEST_TIMEOUT_SECONDS=15
MAX_PAGE_BYTES=2000000        # pages larger than this are rejected
MAX_REDIRECTS=5
RESPECT_ROBOTS_TXT=true
PER_DOMAIN_MIN_INTERVAL_SECONDS=1.0   # minimum gap between requests to the same host
ALLOW_PRIVATE_NETWORKS=false  # leave false. Only the local demo and the tests turn it on

# --- Cache ---
CACHE_TTL_SECONDS=3600        # 0 disables the cache
CACHE_MAX_ENTRIES=1000

# --- API ---
API_KEY=                      # if set, POST /extract requires the header X-API-Key

# --- LLM fallback (any OpenAI-compatible API; default is the Groq free tier) ---
# Leave LLM_API_KEY empty to skip the LLM step: missing fields stay null.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_CHARS=12000

# --- JavaScript rendering (optional, needs: pip install -r requirements-render.txt && playwright install chromium) ---
RENDER_JS=false
RENDER_MIN_TEXT_CHARS=200     # render only if the static page has less visible text than this
RENDER_TIMEOUT_SECONDS=20
RENDER_EXECUTABLE_PATH=       # optional: path to an existing Chromium/Chrome instead of Playwright's download
